# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, as they are sensitive
*.tfvars
*.tfvars.json

# Override files as they are used for local development
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include example tfvars
!terraform.tfvars.example

# Binary
*.terraform.lock.hcl

.idea/